# Contact form delivery (optional).
# Get a free access key at https://web3forms.com (enter the email address that should receive messages),
# then copy this file to .env.local and paste the key below. On Vercel, add the same variable under
# Project → Settings → Environment Variables and redeploy.
# Without a key, the form falls back to opening the visitor's email app with the message pre-filled.
VITE_WEB3FORMS_ACCESS_KEY=
